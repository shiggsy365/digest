DIGEST_SECRET_KEY=replace-with-at-least-32-random-characters
DIGEST_VERSION=latest
DIGEST_DB_PASSWORD=replace-with-a-long-random-password
DIGEST_LIBRARY_PATH=/mnt/books/library
DIGEST_BIND_ADDRESS=127.0.0.1
DIGEST_PORT=8000
DIGEST_PUBLIC_URL=https://digest.example.com
DIGEST_SCAN_INTERVAL_SECONDS=60
DIGEST_METADATA_REFRESH_HOURS=168
DIGEST_SESSION_DAYS=30
DIGEST_TRUSTED_DEVICE_DAYS=180
DIGEST_EREADER_SPA=0
TZ=Europe/London
PUID=1000
PGID=1000

# Optional direct-download acquisition (`docker compose --profile acquisition up -d`).
SHELFMARK_PORT=8084
AA_BASE_URL=
AA_MIRROR_URLS=
LIBGEN_MIRROR_URLS=
ZLIB_MIRROR_URLS=
USING_TOR=false

# Optional Usenet acquisition (`docker compose --profile usenet up -d`).
PROWLARR_PORT=9696
SABNZBD_PORT=8080
DIGEST_INCOMPLETE_PATH=/mnt/books/incomplete

# Enable these only after the local test works and DNS points at Traefik.
DIGEST_TRAEFIK_ENABLED=true
DIGEST_HOSTNAME=digest.example.com
DOCKER_NETWORK=aio_network
DOCKER_NETWORK_EXTERNAL=true
